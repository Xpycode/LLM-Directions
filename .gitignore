# macOS
.DS_Store

# Archive (internal artifacts, not for distribution)
.archive/

# Local/personal files (not part of the system)
docs-browser.html
docs.sh

# Cross-project status dashboard — disposable on-demand artifact (decision 2026-06-13)
dashboard.html
dashboard.py

# Session logs (project-specific, not template)
sessions/*.md
!sessions/_index.md
!sessions/_index-archive.md

# Syncthing temp files
.syncthing.*.tmp
*.sync-conflict-*

# Embedding cache
.fastembed_cache/

# Serena tool cache
.serena/

# Skills managed externally by npx skills
.claude/skills/
.agents/

# Machine-local hook evidence log (delivery-gate/verify hooks) — not shared state
.claude/logs/

# Per-session scratch (session-state-management); disposable + a cross-Mac conflict footgun
WORKING_NOTES.md
RESUME.md

# But keep Claude settings as reference
!.claude/settings.local.json

.cowork/
__pycache__/

# ── Secrets ──────────────────────────────────────────────────────────────
# This repo is PUBLIC. Nothing below has ever been committed; these patterns
# exist so a stray credential can't be added by accident. Adding a pattern
# does NOT untrack an already-committed file, and does NOT remove it from
# history — if something leaks, rotate the credential first
# (54_security-rules.md § "If You Find a Security Issue"), then rewrite history.

# Environment / config
.env
.env.*
!.env.example
!.env.template
.netrc
.npmrc

# Keys & certificates
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Apple signing & notarization (61_distribution-notarization.md)
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
*.keychain
*.keychain-db

# Credential dumps
secrets.*
*secrets.json
*credentials.json
service-account*.json
