  "cases": [
    {
      "id": "two-projects",
      "criteria": [
        "AC01"
      ],
      "given": {
        "slot": null
      },
      "when": [
        "request A from Penumbra",
        "request B from Game One",
        "present FIFO head",
        "humanYes A"
      ],
      "expect": {
        "A": "countdown",
        "B": "queued",
        "reservedCount": 1,
        "inputEvents": 0
      }
    },
    {
      "id": "typing-is-not-approval",
      "criteria": [
        "AC02"
      ],
      "given": {
        "A": "awaitingDecision",
        "focus": "otherApp"
      },
      "when": [
        "ordinary Return",
        "ordinary Space",
        "first click on inactive panel"
      ],
      "expect": {
        "A": "awaitingDecision",
        "focus": "otherApp",
        "inputEvents": 0
      }
    },
    {
      "id": "no-and-request-retry",
      "criteria": [
        "AC03",
        "AC21"
      ],
      "given": {
        "A": "awaitingDecision",
        "key": "k1"
      },
      "when": [
        "humanNo A",
        "request again with k1 and equal content"
      ],
      "expect": {
        "A": "denied",
        "requestCount": 1,
        "promptCount": 1,
        "inputEvents": 0
      }
    },
    {
      "id": "wait-needs-review",
      "criteria": [
        "AC04"
      ],
      "given": {
        "A": "awaitingDecision"
      },
      "when": [
        "humanWait A",
        "advance 600000ms",
        "another request finishes"
      ],
      "expect": {
        "A": "deferred",
        "inputEvents": 0
      }
    },
    {
